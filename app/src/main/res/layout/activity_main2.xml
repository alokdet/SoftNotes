<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity2">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/view_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/capture_image"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:src="@drawable/icon_camera"
        android:layout_marginBottom="5dp"
        app:layout_constraintBottom_toTopOf="@id/recognised_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/write_text" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/write_text"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:src="@drawable/icon_edit"
        android:layout_marginBottom="5dp"
        app:layout_constraintBottom_toTopOf="@id/recognised_text"
        app:layout_constraintStart_toEndOf="@id/capture_image"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/recognised_text"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:fontFamily="@font/roboto_regular"
        android:scrollbars="vertical"
        android:textColor="?attr/sub_text_color"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>