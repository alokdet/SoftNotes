<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="210dp"
    android:id="@+id/instant_tasks_reminder"
    android:background="?attr/background_color"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/task_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Task on the Go!"
        android:textSize="24sp"
        android:fontFamily="@font/roboto_thin"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="?attr/title_text_color"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="30dp"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/task_left_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:text="20 minutes left"
        app:layout_constraintTop_toBottomOf="@id/task_name"
        app:layout_constraintStart_toStartOf="@id/task_name"
        app:layout_constraintEnd_toEndOf="@id/task_name"/>

</androidx.constraintlayout.widget.ConstraintLayout>