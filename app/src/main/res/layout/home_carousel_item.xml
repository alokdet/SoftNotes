<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="210dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/carousel_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/folder_layout"
        android:layout_width="80dp"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        android:background="@drawable/rect_round"
        android:layout_marginStart="18dp"
        android:layout_marginBottom="18dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/folder1"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/icon_folder"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:tint="?attr/icon_tint" />

        <TextView
            android:id="@+id/text1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Folder"
            app:layout_constraintStart_toStartOf="@id/folder1"
            app:layout_constraintEnd_toEndOf="@id/folder1"
            app:layout_constraintTop_toBottomOf="@id/folder1"/>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/folder2"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/icon_folder"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/text1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:tint="?attr/icon_tint" />

        <TextView
            android:id="@+id/text2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Folder"
            app:layout_constraintStart_toStartOf="@id/folder1"
            app:layout_constraintEnd_toEndOf="@id/folder1"
            app:layout_constraintTop_toBottomOf="@id/folder2"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>