<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/foreground_color"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".Fragments.ToolsFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/workspace_layer_surface"
        android:backgroundTint="?attr/background_color"
        android:layout_margin="7dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tasks_reminder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"/>

        <LinearLayout
            android:id="@+id/divider"
            android:layout_width="80dp"
            android:layout_height="5dp"
            app:layout_constraintTop_toBottomOf="@id/tasks_reminder"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="5dp"
            android:background="@drawable/workspace_layer_surface" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/root_folders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            app:layout_constraintTop_toBottomOf="@id/divider"/>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/create_new_folder"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/icon_add"
            android:padding="14dp"
            android:visibility="gone"
            android:background="@drawable/circular_background"
            app:layout_constraintEnd_toStartOf="@id/navigate_to_main_folder"
            android:layout_marginEnd="30dp"
            app:layout_constraintTop_toTopOf="@id/navigate_to_main_folder"
            app:layout_constraintBottom_toBottomOf="@id/navigate_to_main_folder"
            app:tint="?attr/icon_tint"
            android:backgroundTint="#EFA498"/>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/navigate_to_main_folder"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginBottom="30dp"
            android:src="@drawable/icon_view_list"
            android:padding="16dp"
            android:background="@drawable/circular_background"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="30dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:tint="?attr/icon_tint"/>


    </androidx.constraintlayout.widget.ConstraintLayout>


</LinearLayout>