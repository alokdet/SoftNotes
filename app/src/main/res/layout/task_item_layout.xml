<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="17dp"
    android:layout_marginStart="18dp"
    android:layout_marginEnd="18dp"
    android:layout_marginTop="18dp"
    android:background="@drawable/task_preview_background"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/check_task"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="20dp"
        android:padding="10dp"
        android:src="@drawable/icon_done"
        android:background="@drawable/circular_background"
        android:backgroundTint="@color/selectionColor"
        app:layout_constraintBottom_toBottomOf="@id/task_due_tv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/task_name"
        app:tint="@color/white" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/task_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="17dp"
        android:layout_marginEnd="88dp"
        android:text="Videos"
        android:textColor="?attr/title_text_color"
        android:textSize="17sp"
        android:ellipsize="end"
        android:singleLine="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/task_due_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Due: Saturday, 27 May"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="@id/task_name"
        app:layout_constraintTop_toBottomOf="@id/task_name" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/task_details_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/task_due_tv">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/steps_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toTopOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>