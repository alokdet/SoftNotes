<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/bottom_sheet_dia"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="24dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/workspace_layer_surface"
    android:backgroundTint="?attr/background_color"
    app:layout_behavior="@string/bottom_sheet_behavior"
    app:behavior_hideable="true"
    app:behavior_peekHeight="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bs_cont"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        android:paddingBottom="50dp">

        <View
            android:id="@+id/scroll_handle"
            android:layout_width="50dp"
            android:layout_height="3dp"
            android:background="@drawable/xxxxxxxxxxxxxx"
            android:backgroundTint="@color/onBackground_light"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="15dp"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/top_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Average of the column"
            android:fontFamily="@font/roboto_regular"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/scroll_handle"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="18dp"
            android:layout_marginStart="24dp"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/key_column"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KEY"
            android:textSize="16sp"
            android:padding="10dp"
            android:layout_marginTop="30dp"
            android:textColor="@color/white"
            android:background="@drawable/xxxxxxxxxxxxxx"
            android:backgroundTint="@color/onBackground_light"
            app:layout_constraintTop_toBottomOf="@id/top_text"
            app:layout_constraintStart_toStartOf="@id/result" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/value_column"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VALUE"
            android:textSize="16sp"
            android:padding="10dp"
            android:background="@drawable/xxxxxxxxxxxxxx"
            android:backgroundTint="@color/android_green"
            android:layout_marginStart="12dp"
            app:layout_constraintTop_toTopOf="@id/key_column"
            app:layout_constraintStart_toEndOf="@id/key_column"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/result"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.0"
            android:textSize="42sp"
            android:fontFamily="@font/roboto_thin"
            android:layout_marginTop="30dp"
            android:textColor="?attr/title_text_color"
            app:layout_constraintTop_toBottomOf="@id/key_column"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/close_result_panel"
            android:layout_width="50dp"
            android:layout_height="25dp"
            android:src="@drawable/icon_close"
            android:tint="@color/background_light"
            android:layout_marginTop="30dp"
            android:background="@drawable/xxxxxxxxxxxxxx"
            android:backgroundTint="@color/onBackground_light"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginEnd="24dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>