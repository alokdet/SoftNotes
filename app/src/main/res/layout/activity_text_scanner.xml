<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".TextScannerActivity">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/image_to_scan"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:padding="32dp"
        app:tint="@color/onBackground_light"
        android:src="@drawable/icon_add"
        android:background="@drawable/workspace_layer_surface"
        android:backgroundTint="?attr/background_color"
        android:layout_marginTop="50dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toTopOf="parent"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/images_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/image_grid_background"
        android:layout_marginTop="25dp"
        android:scrollbars="vertical"
        android:fadeScrollbars="false"
        android:scrollbarThumbVertical="@drawable/scrollbar_thumb"
        android:scrollbarSize="5dp"
        app:layout_constraintTop_toBottomOf="@id/image_to_scan"/>

</androidx.constraintlayout.widget.ConstraintLayout>