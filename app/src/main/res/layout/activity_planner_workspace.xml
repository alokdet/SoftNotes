<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/parent_planner_layout"
    tools:context=".PlannerWorkspace">

    <com.example.softnotesbeta.Views.DrawBoard
        android:id="@+id/draw_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="58dp"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/actions_two"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="?attr/background_color"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/erase_all"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/delete_fill0_wght400_grad0_opsz48"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/undo"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="28dp"
            app:tint="?attr/icon_tint"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="8dp"/>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/undo"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/icon_undo"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginStart="28dp"
            app:tint="?attr/icon_tint"
            app:layout_constraintStart_toEndOf="@id/erase_all"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="8dp"/>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/redo"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/icon_redo"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginStart="28dp"
            app:tint="?attr/icon_tint"
            app:layout_constraintStart_toEndOf="@id/undo"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="8dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>