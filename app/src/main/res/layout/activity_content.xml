<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/background_color"
    tools:context=".ContentActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/transition_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/note_preview_background"
        android:backgroundTint="?attr/foreground_color"
        android:layout_margin="5dp">

        <ScrollView
            android:id="@+id/note_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:backgroundTint="@color/android_green"
                    android:background="@drawable/foreground_layer_surface"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/close_content_panel"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginTop="24dp"
                        android:layout_marginEnd="24dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:src="@drawable/icon_close"/>

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/step_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Step title"
                        android:textSize="33sp"
                        android:padding="5dp"
                        android:singleLine="true"
                        android:layout_marginStart="24dp"
                        android:layout_marginEnd="24dp"
                        android:layout_marginBottom="20dp"
                        android:background="@color/android_green"
                        android:textColor="?attr/title_text_color"
                        android:fontFamily="@font/roboto_regular"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/input_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Type Note"
                    android:textColor="?attr/title_text_color"
                    android:background="?attr/foreground_color"
                    android:fontFamily="@font/roboto_light"
                    android:lineSpacingExtra="8dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"
                    android:textSize="18sp" />

            </LinearLayout>

        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>