<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="68dp">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/add_drawing"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_marginTop="20dp"
        android:src="@drawable/icon_edit"
        app:layout_constraintEnd_toStartOf="@id/add_image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/icon_tint" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/add_image"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:src="@drawable/icon_image"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/add_drawing"
        app:layout_constraintEnd_toStartOf="@id/add_image_from_camera"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/icon_tint" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/add_image_from_camera"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:src="@drawable/icon_camera_filled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/add_image"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/icon_tint" />

</androidx.constraintlayout.widget.ConstraintLayout>