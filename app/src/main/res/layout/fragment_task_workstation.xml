<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/background_color"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".TaskWorkstation">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/task_actions_view"
        android:layout_width="120dp"
        android:layout_height="60dp"
        android:transitionName="actionBtn"
        android:layout_marginEnd="35dp"
        android:elevation="1dp"
        android:background="@drawable/rounded_box"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/action_btn"
        app:layout_constraintBottom_toTopOf="@id/action_btn">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/expand_view"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/icon_arrow_back_ios"
            android:background="@drawable/circular_background"
            android:backgroundTint="#A1F3C5"
            android:padding="5dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/pause_task"/>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/pause_task"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:visibility="gone"
            android:src="@drawable/baseline_pause_24"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/expand_view"
            app:layout_constraintEnd_toStartOf="@id/start_tts"/>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/start_tts"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:visibility="gone"
            android:src="@drawable/baseline_keyboard_voice_24"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/pause_task"
            app:layout_constraintEnd_toStartOf="@id/edit_task_btn"/>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/edit_task_btn"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/icon_edit"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/start_tts"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/stepper_layout"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/stepper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/action_btn"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:transitionName="actionBtn"
        android:background="@drawable/workspace_layer_surface"
        android:layout_marginTop="250dp">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/step_content_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>