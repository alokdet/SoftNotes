<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/background_color"
    tools:context=".SoftWorkspace">

    <com.example.softnotesbeta.TextArea
        android:id="@+id/edittext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:padding="10dp"
        android:hint="Write here"
        android:textSize="18sp"
        android:textColor="?attr/title_text_color"
        android:fontFamily="@font/roboto_regular"
        android:background="?attr/background_color"
        app:layout_constraintTop_toTopOf="parent"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/calendar"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:padding="10dp"
        android:background="@drawable/rect_round"
        android:backgroundTint="?attr/foreground_color"
        app:tint="?attr/icon_tint"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/ai_box"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="24dp"
        android:src="@drawable/icon_calendar"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/organiser"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:padding="10dp"
        android:background="@drawable/rect_round"
        android:backgroundTint="?attr/foreground_color"
        app:tint="?attr/icon_tint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/ai_box"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:src="@drawable/icon_chart"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ai_box"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="@drawable/workspace_layer_surface"
        android:backgroundTint="?attr/foreground_color"
        app:layout_constraintBottom_toTopOf="@id/notes_tab"
        android:layout_marginBottom="24dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        app:layout_constraintBottom_toBottomOf="parent">


    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/notes_tab"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:transitionName="one"
        android:src="@drawable/icon_view_list"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tasks_tab"
        android:layout_marginBottom="24dp"
        app:tint="@color/android_green" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/tasks_tab"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:transitionName="two"
        android:src="@drawable/icon_splitscreen_top"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/notes_tab"
        app:layout_constraintEnd_toStartOf="@id/mindmaps_tab"
        android:layout_marginBottom="24dp"
        app:tint="?attr/icon_tint" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/mindmaps_tab"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:transitionName="three"
        android:src="@drawable/icon_develepor_board"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/tasks_tab"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="24dp"
        app:tint="?attr/icon_tint" />

</androidx.constraintlayout.widget.ConstraintLayout>