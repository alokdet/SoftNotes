<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    android:background="?attr/background_color"
    tools:context=".MainActivity3">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/background_color"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:elevation="0dp"
            app:contentScrim="?attr/background_color"
            app:expandedTitleMarginBottom="30dp"
            app:expandedTitleMarginTop="50dp"
            app:expandedTitleGravity="center"
            app:collapsedTitleGravity="center"
            app:collapsedTitleTextAppearance="@style/collapsed_title"
            app:expandedTitleTextAppearance="@style/expanded_title"
            app:layout_scrollFlags="scroll|snap|exitUntilCollapsed"
            app:title="">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                app:elevation="0dp"
                app:title=""
                app:titleMarginTop="24dp"
                app:titleTextAppearance="@style/collapsed_title"
                app:titleTextColor="@color/black" />

            <LinearLayout
                android:id="@+id/container"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:gravity="center"
                app:elevation="0dp"
                app:layout_collapseMode="parallax"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/title_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="42sp"
                    android:hint="Title"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"
                    android:singleLine="true"
                    android:fontFamily="@font/roboto_thin"
                    android:textAlignment="center"
                    android:background="?attr/background_color"
                    android:padding="8dp" />

            </LinearLayout>

        </com.google.android.material.appbar.CollapsingToolbarLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/action_btn"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="vertical"
            app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior"
            android:fadeScrollbars="false"
            android:paddingBottom="10dp"
            android:transitionName="steps_shared_list"
            app:layout_constraintTop_toTopOf="parent"
            android:scrollbarThumbVertical="@drawable/scrollbar_thumb"
            android:scrollbarSize="5dp" />


    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/actions_two"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:background="?attr/background_color"
        android:layout_gravity="bottom">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/task_action"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:transitionName="actionBtn"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/xxxxxxxxxxxxxx"
            android:backgroundTint="@color/android_green"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/edit_task"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/icon_edit"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>